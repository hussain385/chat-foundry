{
  "name": "chat-foundry",
  "version": "0.2.0",
  "description": "Headless, cross-platform chat logic for React, React Native, and vanilla JS, with optional customizable chat UIs for web and React Native. Supports OpenAI and Anthropic with streaming.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.mjs",
      "require": "./dist/ui.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.mjs",
      "require": "./dist/native.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "ui",
    "native"
  ],
  "scripts": {
    "build": "node api.js && tsup",
    "dev": "node api.js && tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm run typecheck"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hussain385/chat-foundry.git"
  },
  "homepage": "https://github.com/hussain385/chat-foundry#readme",
  "bugs": {
    "url": "https://github.com/hussain385/chat-foundry/issues"
  },
  "keywords": [
    "chat",
    "chatbot",
    "headless",
    "openai",
    "anthropic",
    "streaming",
    "react",
    "react-native",
    "web-chatbot",
    "mobile-chatbot",
    "hook",
    "ai",
    "llm",
    "chat-ui",
    "chat-widget"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.71.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.3.7",
    "@types/react-test-renderer": "^18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "^0.74.7",
    "react-test-renderer": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "typesVersions": {
    "*": {
      "ui": [
        "./dist/ui.d.ts"
      ],
      "native": [
        "./dist/native.d.ts"
      ]
    }
  }
}
